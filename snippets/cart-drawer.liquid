<div id="cart-drawer-overlay" class="drawer-backdrop"></div>

<aside id="cart-drawer" class="cart-slide-drawer" aria-label="Shopping Toybox">
  <div class="drawer-header">
    <div style="display: flex; align-items: center; gap: 10px;">
      <span style="font-size: 1.5rem;">🎈</span>
      <h3 style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 800; color: var(--color-dark);">Your Toybox</h3>
    </div>
    <button type="button" id="cart-drawer-close" class="drawer-close-btn" aria-label="Close cart">&times;</button>
  </div>

  <!-- Free Shipping Progress Tracker -->
  <div class="shipping-tracker-box">
    <p id="shipping-progress-text" class="shipping-text">
      {% assign threshold = 5000 %}
      {% if cart.total_price >= threshold %}
        🎉 <strong>Congratulations!</strong> You unlocked <strong>FREE Tracked Shipping</strong>!
      {% else %}
        {% assign diff = threshold | minus: cart.total_price %}
        Add <strong>{{ diff | money }}</strong> more to unlock <strong>FREE Tracked Shipping</strong>!
      {% endif %}
    </p>
    <div class="shipping-track-outer">
      {% assign percentage = cart.total_price | times: 100 | divided_by: 5000 %}
      {% if percentage > 100 %}{% assign percentage = 100 %}{% endif %}
      <div id="shipping-progress-bar" class="shipping-track-inner" style="width: {{ percentage | default: 0 }}%;"></div>
    </div>
  </div>

  <!-- Items Container -->
  <div class="drawer-body" id="drawer-body-items">
    {% if cart.item_count > 0 %}
      {% for item in cart.items %}
        <div class="drawer-item-row" data-line="{{ forloop.index }}">
          <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" class="drawer-item-img">
          <div style="flex-grow: 1;">
            <a href="{{ item.url }}" style="font-family: var(--font-heading); font-weight: 700; font-size: 1rem; color: var(--color-dark);">{{ item.product.title }}</a>
            {% unless item.variant.title contains 'Default' %}
              <div style="font-size: 0.85rem; color: #6B7280; margin-top: 2px;">{{ item.variant.title }}</div>
            {% endunless %}
            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px;">
              <span style="font-family: var(--font-heading); font-weight: 800; font-size: 1.1rem; color: var(--color-orange);">{{ item.price | money }}</span>
              <span style="font-size: 0.85rem; font-weight: 700; color: #6B7280;">Qty: {{ item.quantity }}</span>
            </div>
          </div>
          <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="drawer-item-remove" style="color: #EF4444; font-size: 0.82rem; font-weight: 700;">Remove</a>
        </div>
      {% endfor %}
    {% else %}
      <div class="drawer-empty-state">
        <span style="font-size: 3.5rem; display: block; margin-bottom: 12px;">🧸</span>
        <h4 style="font-family: var(--font-heading); font-size: 1.3rem; margin-bottom: 8px;">Your Toybox is Empty!</h4>
        <p style="color: var(--color-dark-muted); font-size: 0.95rem; margin-bottom: 24px;">Discover screen-free developmental toys loved by thousands of families.</p>
        <a href="/collections/all" class="btn-motion-primary" style="display: inline-flex; font-size: 0.95rem; padding: 12px 28px;">
          <span>Explore All Toys 🚀</span>
        </a>
      </div>
    {% endif %}
  </div>

  <!-- Drawer Footer -->
  <div class="drawer-footer">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <span style="font-family: var(--font-heading); font-weight: 700; font-size: 1.05rem;">Subtotal</span>
      <span id="drawer-subtotal" style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--color-dark);">{{ cart.total_price | money }}</span>
    </div>

    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn-primary-luxury" style="width: 100%; justify-content: center; font-size: 1.1rem; padding: 16px;">
        <span>Secure Checkout &rarr;</span>
      </button>
    </form>

    <div style="display: flex; justify-content: center; gap: 14px; margin-top: 14px; color: #9CA3AF; font-size: 0.78rem; font-weight: 600;">
      <span>🔒 256-Bit SSL Encrypted</span> &bull; <span>📦 Free 30-Day Returns</span>
    </div>
  </div>
</aside>