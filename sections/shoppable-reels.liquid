<section id="shoppable-reels" class="reels-section">
  <div class="container">
    <div class="reels-header reveal-on-scroll">
      <div>
        <span class="section-tag">Play In Motion</span>
        <h2 class="section-heading-lg">Watch Toys In Action! 🎬</h2>
        <p class="section-subtext">See how little hands build, stack, balance, and problem-solve during real playtime sessions.</p>
      </div>

      <div class="reels-scroll-hint">
        <span>← Swipe / Scroll To Discover →</span>
      </div>
    </div>

    <!-- Scrollable Video Reels Carousel -->
    <div class="reels-carousel-track">
      <!-- Reel 1: Rainbow Stacker -->
      <div class="reel-card tilt-card reveal-on-scroll">
        <div class="reel-video-container">
          <img 
            src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=800&q=80" 
            alt="Wooden Rainbow Stacker" 
            class="reel-poster-img"
            loading="lazy"
          >
          <div class="reel-badge-top">
            <span class="live-dot"></span>
            <span>Ages 18M – 4 Yrs</span>
          </div>

          <div class="reel-play-icon" title="Watch demo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </div>

          <div class="reel-bottom-sheet">
            <div class="reel-product-info">
              <h4>Wooden Rainbow Stacker</h4>
              <div class="reel-price">$38.00 <span class="reel-compare">$48.00</span></div>
            </div>
            <button 
              type="button" 
              class="reel-quick-btn btn-add-card" 
              data-variant-id="default"
              data-product-title="Montessori Natural Wooden Rainbow Stacker"
              data-product-price="$38.00"
              data-product-img="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=140&q=80"
              aria-label="Add Wooden Rainbow Stacker to Toybox"
            >
              + Buy
            </button>
          </div>
        </div>
      </div>

      <!-- Reel 2: Robotics Kit -->
      <div class="reel-card tilt-card reveal-on-scroll">
        <div class="reel-video-container">
          <img 
            src="https://images.unsplash.com/photo-1485827404703-89b55fcc595e?auto=format&fit=crop&w=800&q=80" 
            alt="Solar Robotics Kit" 
            class="reel-poster-img"
            loading="lazy"
          >
          <div class="reel-badge-top">
            <span class="live-dot"></span>
            <span>Ages 6 – 12 Yrs</span>
          </div>

          <div class="reel-play-icon" title="Watch demo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </div>

          <div class="reel-bottom-sheet">
            <div class="reel-product-info">
              <h4>Solar Robotic Explorer</h4>
              <div class="reel-price">$49.50 <span class="reel-compare">$62.00</span></div>
            </div>
            <button 
              type="button" 
              class="reel-quick-btn btn-add-card" 
              data-variant-id="default"
              data-product-title="Solar &amp; Hydro Robotic Science Explorers Kit"
              data-product-price="$49.50"
              data-product-img="https://images.unsplash.com/photo-1485827404703-89b55fcc595e?auto=format&fit=crop&w=140&q=80"
              aria-label="Add Solar Robotic Explorer to Toybox"
            >
              + Buy
            </button>
          </div>
        </div>
      </div>

      <!-- Reel 3: Silicone Teethers -->
      <div class="reel-card tilt-card reveal-on-scroll">
        <div class="reel-video-container">
          <img 
            src="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=800&q=80" 
            alt="Silicone Nesting Teether Cups" 
            class="reel-poster-img"
            loading="lazy"
          >
          <div class="reel-badge-top">
            <span class="live-dot"></span>
            <span>Ages 3M – 2 Yrs</span>
          </div>

          <div class="reel-play-icon" title="Watch demo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </div>

          <div class="reel-bottom-sheet">
            <div class="reel-product-info">
              <h4>Silicone Nesting Cups</h4>
              <div class="reel-price">$22.00 <span class="reel-compare">$28.00</span></div>
            </div>
            <button 
              type="button" 
              class="reel-quick-btn btn-add-card" 
              data-variant-id="default"
              data-product-title="Organic Food-Grade Silicone Stacking Teethers"
              data-product-price="$22.00"
              data-product-img="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=140&q=80"
              aria-label="Add Silicone Nesting Cups to Toybox"
            >
              + Buy
            </button>
          </div>
        </div>
      </div>

      <!-- Reel 4: Magnetic Architecture Tiles -->
      <div class="reel-card tilt-card reveal-on-scroll">
        <div class="reel-video-container">
          <img 
            src="https://images.unsplash.com/photo-1587654780291-39c9404d746b?auto=format&fit=crop&w=800&q=80" 
            alt="Magnetic Architectural Tiles" 
            class="reel-poster-img"
            loading="lazy"
          >
          <div class="reel-badge-top">
            <span class="live-dot"></span>
            <span>Ages 3 – 8 Yrs</span>
          </div>

          <div class="reel-play-icon" title="Watch demo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </div>

          <div class="reel-bottom-sheet">
            <div class="reel-product-info">
              <h4>Magnetic 3D Tiles (108 Pcs)</h4>
              <div class="reel-price">$58.00 <span class="reel-compare">$75.00</span></div>
            </div>
            <button 
              type="button" 
              class="reel-quick-btn btn-add-card" 
              data-variant-id="default"
              data-product-title="Luminescent Magnetic Architectural Tiles Set"
              data-product-price="$58.00"
              data-product-img="https://images.unsplash.com/photo-1587654780291-39c9404d746b?auto=format&fit=crop&w=140&q=80"
              aria-label="Add Magnetic 3D Tiles to Toybox"
            >
              + Buy
            </button>
          </div>
        </div>
      </div>

      <!-- Reel 5: Balance Bike -->
      <div class="reel-card tilt-card reveal-on-scroll">
        <div class="reel-video-container">
          <img 
            src="https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=800&q=80" 
            alt="Nordic Balance Bike" 
            class="reel-poster-img"
            loading="lazy"
          >
          <div class="reel-badge-top">
            <span class="live-dot"></span>
            <span>Ages 2 – 5 Yrs</span>
          </div>

          <div class="reel-play-icon" title="Watch demo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </div>

          <div class="reel-bottom-sheet">
            <div class="reel-product-info">
              <h4>Ergonomic Balance Bike</h4>
              <div class="reel-price">$89.00 <span class="reel-compare">$110.00</span></div>
            </div>
            <button 
              type="button" 
              class="reel-quick-btn btn-add-card" 
              data-variant-id="default"
              data-product-title="Ergonomic Lightweight Wooden Balance Bike"
              data-product-price="$89.00"
              data-product-img="https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=140&q=80"
              aria-label="Add Ergonomic Balance Bike to Toybox"
            >
              + Buy
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shoppable Video Reels",
  "settings": [],
  "presets": [
    {
      "name": "Shoppable Video Reels"
    }
  ]
}
{% endschema %}