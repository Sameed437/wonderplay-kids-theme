<section class="hero-editorial">
  <div class="container hero-editorial-grid">
    <div class="hero-text-column">
      <div class="hero-eyebrow">
        <span>🌿</span> Certified 100% Non-Toxic & Screen-Free
      </div>

      <h1 class="hero-headline">
        Thoughtfully designed toys for <em>limitless</em> young minds.
      </h1>

      <p class="hero-lead">
        We partner with child developmental psychologists and master artisans to create heirloom-quality, open-ended play essentials that nurture creativity, independence, and calm homes.
      </p>

      <div class="hero-action-cluster">
        <a href="/collections/all" class="btn-primary-luxury">
          Explore The Curations &rarr;
        </a>
        <a href="#milestones" class="btn-secondary-luxury">
          Shop by Developmental Stage
        </a>
      </div>

      <div class="hero-social-proof">
        <div class="avatar-stack">
          <span>EM</span>
          <span>AR</span>
          <span>JD</span>
          <span>SL</span>
        </div>
        <div>
          <div class="proof-stars">★★★★★</div>
          <div class="proof-text">Rated 4.95 / 5 by over 14,200+ modern parents & educators</div>
        </div>
      </div>
    </div>

    <!-- Visual Media Composition -->
    <div class="hero-visual-frame">
      <img 
        src="https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=1200&q=85" 
        alt="Children playing with modern wooden toys" 
        class="hero-image-main"
        loading="eager"
      >

      <!-- Floating Glass Card 1 (Top Right) -->
      <div class="hero-glass-card top-right">
        <div class="card-icon-pill">🏆</div>
        <div>
          <div style="font-size: 0.88rem; font-weight: 800; color: var(--color-dark);">Best Toy Design 2024</div>
          <div style="font-size: 0.74rem; color: #6B7280;">Montessori Excellence Award</div>
        </div>
      </div>

      <!-- Floating Glass Card 2 (Bottom Left) -->
      <div class="hero-glass-card bottom-left">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
          <span style="color: #059669; font-size: 0.9rem;">●</span>
          <span style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-sage);">Eco-Certified Wood</span>
        </div>
        <p style="font-size: 0.8rem; line-height: 1.4; color: var(--color-dark-muted); margin: 0;">FSC® sustainably harvested beechwood with organic vegetable dyes.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Editorial",
  "settings": [],
  "presets": [
    {
      "name": "Hero Editorial"
    }
  ]
}
{% endschema %}
