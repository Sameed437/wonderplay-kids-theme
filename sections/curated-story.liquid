<section class="editorial-story-section">
  <div class="container story-grid">
    <div class="story-media-stack reveal-on-scroll">
      <img 
        src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=1000&q=85" 
        alt="Aesthetic modern playroom with wooden toys" 
        class="story-image-main"
        loading="lazy"
      >
      <div class="story-quote-card">
        <p>"Children don't need noisy electronics. They need tools that invite their own thoughts to come alive."</p>
        <span>Dr. Clara Vance, Child Development Specialist</span>
      </div>
    </div>

    <div class="story-content reveal-on-scroll">
      <span class="section-tag">Our Play Philosophy</span>
      <h2>Designed for Little Hands. <br/>Made for Beautiful Homes.</h2>
      <p>
        We were tired of loud, over-stimulating plastic junk that broke within weeks and cluttered the living room. Wonderplay was founded with an architectural eye and a parent’s loving heart.
      </p>
      <p>
        Every curve, grain of German beechwood, and food-grade non-toxic dye is chosen to inspire open-ended play. Your child leads the storyline — our toys are simply the sparks.
      </p>

      <div class="story-stats-grid">
        <div class="story-stat-card">
          <div class="stat-number">100%</div>
          <div class="stat-label">Non-Toxic &amp; Safe</div>
        </div>
        <div class="story-stat-card">
          <div class="stat-number">FSC®</div>
          <div class="stat-label">Certified Sustainable</div>
        </div>
        <div class="story-stat-card">
          <div class="stat-number">14k+</div>
          <div class="stat-label">Happy Playrooms</div>
        </div>
      </div>

      <div style="margin-top: 32px;">
        <a href="/pages/about-us" class="btn-motion-primary">
          <span>Read Our Founding Story &rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story Editorial",
  "settings": [],
  "presets": [
    {
      "name": "Brand Story Editorial"
    }
  ]
}
{% endschema %}