<div class="header-floating-wrapper">
  <header class="site-header-pill">
    <!-- Official Wonderplay Logo (Fitted & Transparent) -->
    <a href="{{ routes.root_url }}" class="brand-logo-wrap" title="Wonderplay — Where Fun Begins!">
      <img 
        src="{{ 'logo.png' | asset_url }}" 
        alt="Wonderplay — Where Fun Begins!" 
        class="brand-logo-img"
        width="160"
        height="44"
        loading="eager"
      >
    </a>

    <!-- Single-Line Centered Navigation (Desktop) -->
    <nav class="nav-desktop-wrap" aria-label="Main Navigation">
      <ul class="nav-desktop">
        <li><a href="/collections/all">Explore Toys</a></li>
        <li>
          <a href="/collections/stem-learning">
            STEM &amp; Science
            <span class="nav-tag-hot">HOT 🔥</span>
          </a>
        </li>
        <li><a href="/collections/wooden-montessori">Wooden &amp; Montessori</a></li>
        <li><a href="/collections/baby-toddler">Baby &amp; Toddler</a></li>
        <li><a href="/collections/creative-arts">Arts &amp; Crafts</a></li>
        <li><a href="/pages/about-us">Our Story</a></li>
      </ul>
    </nav>

    <!-- Header Actions (Search, Cart Drawer & Mobile Hamburger) -->
    <div class="header-utilities">
      <a href="/search" class="btn-icon-soft" title="Search catalog" aria-label="Search catalog">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </a>

      <!-- Open Slide-in Cart Drawer -->
      <a href="{{ routes.cart_url }}" class="bag-btn open-cart-drawer" aria-label="Open Toybox">
        <span>🛒 Toybox</span>
        <span class="bag-count">{{ cart.item_count }}</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button type="button" class="mobile-menu-toggle" id="mobile-menu-open-btn" aria-label="Open Navigation Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>
</div>

<!-- Mobile Navigation Slide-out Drawer -->
<div id="mobile-menu-backdrop" class="drawer-backdrop"></div>
<aside id="mobile-menu-drawer" class="mobile-nav-drawer" aria-label="Mobile Navigation Menu">
  <div class="mobile-nav-header">
    <a href="{{ routes.root_url }}">
      <img 
        src="{{ 'logo.png' | asset_url }}" 
        alt="Wonderplay — Where Fun Begins!" 
        class="mobile-nav-logo"
        width="130"
        height="36"
      >
    </a>
    <button type="button" id="mobile-menu-close-btn" class="drawer-close-btn" aria-label="Close menu">&times;</button>
  </div>

  <div class="mobile-nav-body">
    <!-- Search shortcut -->
    <form action="/search" method="get" class="mobile-search-form" role="search">
      <input type="search" name="q" placeholder="Search toys, milestones, STEM..." class="mobile-search-input" aria-label="Search toys">
      <button type="submit" class="mobile-search-btn" aria-label="Search">🔍</button>
    </form>

    <!-- Milestone Quick Pills -->
    <div class="mobile-section-label">Shop by Age &amp; Milestone</div>
    <div class="mobile-milestones-grid">
      <a href="/collections/baby-toddler" class="mobile-milestone-pill stage-1">🍼 0–12M</a>
      <a href="/collections/baby-toddler" class="mobile-milestone-pill stage-2">🧸 1–2 Yrs</a>
      <a href="/collections/wooden-montessori" class="mobile-milestone-pill stage-3">🧩 3–5 Yrs</a>
      <a href="/collections/stem-learning" class="mobile-milestone-pill stage-4">🚀 6–8 Yrs</a>
      <a href="/collections/creative-arts" class="mobile-milestone-pill stage-5">🎨 9+ Yrs</a>
    </div>

    <!-- Main Navigation Links -->
    <div class="mobile-section-label">Play Collections</div>
    <ul class="mobile-nav-list">
      <li><a href="/collections/all"><span>🧸 Explore All Toys</span> <span class="mobile-arrow">&rarr;</span></a></li>
      <li><a href="/collections/stem-learning"><span>🚀 STEM &amp; Science Kits</span> <span class="nav-tag-hot">HOT 🔥</span></a></li>
      <li><a href="/collections/wooden-montessori"><span>🧩 Wooden &amp; Montessori</span> <span class="mobile-arrow">&rarr;</span></a></li>
      <li><a href="/collections/baby-toddler"><span>🍼 Baby &amp; Toddler Teethers</span> <span class="mobile-arrow">&rarr;</span></a></li>
      <li><a href="/collections/creative-arts"><span>🎨 Arts &amp; Crafts Studios</span> <span class="mobile-arrow">&rarr;</span></a></li>
      <li><a href="/pages/about-us"><span>💛 Our Founding Story</span> <span class="mobile-arrow">&rarr;</span></a></li>
    </ul>

    <!-- Trust Badges & Contact in Mobile Menu -->
    <div class="mobile-nav-footer">
      <div class="mobile-trust-badges">
        <span>🛡️ ASTM F963 Safe</span> &bull; <span>🌲 FSC® Certified Hardwood</span>
      </div>
      <a href="mailto:support@wonderplay.com" class="mobile-support-link">
        💬 Joy Team: support@wonderplay.com
      </a>
    </div>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}