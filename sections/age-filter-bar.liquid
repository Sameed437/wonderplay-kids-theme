<section id="milestones" class="milestones-section">
  <div class="container">
    <div class="reels-header reveal-on-scroll">
      <div>
        <span class="section-tag">Shop by Age &amp; Milestone</span>
        <h2 class="section-heading-lg">Tailored for Every Growing Adventurer!</h2>
        <p class="section-subtext">Each stage of childhood brings new skills to discover. Find the perfect toy for their age!</p>
      </div>
      <div>
        <a href="/collections/all" class="btn-motion-glass" style="color: var(--color-dark); border-color: var(--color-orange); font-size: 0.95rem; padding: 12px 24px;">
          View All Ages &rarr;
        </a>
      </div>
    </div>

    <div class="milestones-track">
      <!-- Stage 1 -->
      <a href="/collections/baby-toddler" class="milestone-pill-card stage-1 reveal-on-scroll">
        <span class="milestone-badge">Stage 01</span>
        <span class="milestone-icon">🍼</span>
        <h3 class="milestone-title">0 – 12 Months</h3>
        <p class="milestone-desc">Sensory teething, soft grasp toys, and gentle visual curiosity.</p>
        <span class="milestone-link">Explore Stage &rarr;</span>
      </a>

      <!-- Stage 2 -->
      <a href="/collections/baby-toddler" class="milestone-pill-card stage-2 reveal-on-scroll">
        <span class="milestone-badge">Stage 02</span>
        <span class="milestone-icon">🧸</span>
        <h3 class="milestone-title">1 – 2 Years</h3>
        <p class="milestone-desc">First steps, motor balance, tactile stacking cups, and shape discovery.</p>
        <span class="milestone-link">Explore Stage &rarr;</span>
      </a>

      <!-- Stage 3 -->
      <a href="/collections/wooden-montessori" class="milestone-pill-card stage-3 reveal-on-scroll">
        <span class="milestone-badge">Stage 03</span>
        <span class="milestone-icon">🧩</span>
        <h3 class="milestone-title">3 – 5 Years</h3>
        <p class="milestone-desc">Montessori rainbow building, puzzle solving, and pretend play.</p>
        <span class="milestone-link">Explore Stage &rarr;</span>
      </a>

      <!-- Stage 4 -->
      <a href="/collections/stem-learning" class="milestone-pill-card stage-4 reveal-on-scroll">
        <span class="milestone-badge">Stage 04</span>
        <span class="milestone-icon">🚀</span>
        <h3 class="milestone-title">6 – 8 Years</h3>
        <p class="milestone-desc">Solar robotics, mechanical kits, magnetic geometry, and science labs.</p>
        <span class="milestone-link">Explore Stage &rarr;</span>
      </a>

      <!-- Stage 5 -->
      <a href="/collections/creative-arts" class="milestone-pill-card stage-5 reveal-on-scroll">
        <span class="milestone-badge">Stage 05</span>
        <span class="milestone-icon">🎨</span>
        <h3 class="milestone-title">9+ Years</h3>
        <p class="milestone-desc">Real pottery studios, astronomical telescopes, and advanced creations.</p>
        <span class="milestone-link">Explore Stage &rarr;</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Milestones Section",
  "settings": [],
  "presets": [
    {
      "name": "Milestones Section"
    }
  ]
}
{% endschema %}
