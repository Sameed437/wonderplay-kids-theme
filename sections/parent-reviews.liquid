<section class="testimonials-section">
  <div class="container">
    <div class="reels-header reveal-on-scroll" style="text-align: center; display: block; max-width: 680px; margin: 0 auto 48px;">
      <span class="section-tag">Parent Approved</span>
      <h2 class="section-heading-lg">Endorsed by Parents, Loved by Kids! ⭐</h2>
      <p class="section-subtext" style="margin: 10px auto 0;">Over 14,000 families trust Wonderplay for meaningful, joyful, screen-free afternoons.</p>
      
      <div class="trust-metric-bar" style="display: inline-flex; align-items: center; gap: 10px; margin-top: 18px; background: #FFF; border: 2px solid var(--color-yellow); border-radius: var(--radius-pill); padding: 8px 24px; box-shadow: var(--shadow-candy);">
        <span style="color: #F59E0B; font-weight: 800; font-size: 1.1rem;">★★★★★</span>
        <span style="font-family: var(--font-heading); font-weight: 800; font-size: 0.92rem; color: var(--color-dark);">4.95 / 5 Rating &bull; 1,420+ Verified Reviews</span>
      </div>
    </div>

    <div class="reviews-grid-editorial">
      <div class="review-card-luxury tilt-card reveal-on-scroll">
        <div class="review-rating-stars">★★★★★</div>
        <p class="review-quote-body">
          "The Wooden Rainbow stacker is pure magic! It looks gorgeous on our living room shelf, and our 3-year-old builds tunnels, towers, and bridges with it every single afternoon."
        </p>
        <div class="reviewer-meta-cluster">
          <div class="reviewer-photo-chip" style="background: #FFE5EC; color: #FF477E;">SL</div>
          <div>
            <div class="reviewer-name-line">Sarah Lindemann</div>
            <div class="reviewer-verified-sub">
              <span>✓ Verified Parent</span> • <span>Mother of 2, Brooklyn NY</span>
            </div>
          </div>
        </div>
      </div>

      <div class="review-card-luxury tilt-card reveal-on-scroll">
        <div class="review-rating-stars">★★★★★</div>
        <p class="review-quote-body">
          "As an elementary STEM teacher and father, I am picky with science toys. The Solar Robotics kit is by far the highest-quality gear assembly I have seen in children's education."
        </p>
        <div class="reviewer-meta-cluster">
          <div class="reviewer-photo-chip" style="background: #E0F2FE; color: #0284C7;">MR</div>
          <div>
            <div class="reviewer-name-line">Marcus Reynolds</div>
            <div class="reviewer-verified-sub">
              <span>✓ Verified Parent</span> • <span>STEM Educator, Austin TX</span>
            </div>
          </div>
        </div>
      </div>

      <div class="review-card-luxury tilt-card reveal-on-scroll">
        <div class="review-rating-stars">★★★★★</div>
        <p class="review-quote-body">
          "Barnaby the weighted plush bear completely solved our bedtime battles! The gentle weight and super soft fur comfort our toddler right to sleep within minutes."
        </p>
        <div class="reviewer-meta-cluster">
          <div class="reviewer-photo-chip" style="background: #FEF3C7; color: #D97706;">EC</div>
          <div>
            <div class="reviewer-name-line">Elena Chen</div>
            <div class="reviewer-verified-sub">
              <span>✓ Verified Parent</span> • <span>San Francisco CA</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Parent Testimonials",
  "settings": [],
  "presets": [
    {
      "name": "Parent Testimonials"
    }
  ]
}
{% endschema %}