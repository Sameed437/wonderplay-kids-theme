<div class="container" style="padding: 48px 24px;">
  <div style="text-align: center; max-width: 680px; margin: 0 auto 48px;">
    <h1 style="font-size: 2.8rem; margin-bottom: 12px;">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div style="color: #64748B; font-size: 1.1rem; line-height: 1.6;">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  <div class="products-grid">
    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% else %}
      <p style="grid-column: 1 / -1; text-align: center; color: #94A3B8; padding: 48px 0; font-size: 1.2rem;">
        No products found in this category yet.
      </p>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
