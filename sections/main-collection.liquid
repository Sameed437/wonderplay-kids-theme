<div class="container" style="padding: clamp(40px, 6vw, 64px) clamp(16px, 4vw, 36px);">
  <div style="text-align: center; max-width: 680px; margin: 0 auto 48px;">
    <span class="section-tag">Wonderplay Playroom</span>
    <h1 style="font-size: clamp(2.4rem, 4vw, 3.2rem); margin-bottom: 12px;">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div style="color: var(--color-dark-muted); font-size: 1.1rem; line-height: 1.6; font-weight: 600;">
        {{ collection.description }}
      </div>
    {% else %}
      <div style="color: var(--color-dark-muted); font-size: 1.1rem; line-height: 1.6; font-weight: 600;">
        Screen-free developmental toys, crafted from FSC®-certified beechwood and child-safe materials.
      </div>
    {% endif %}
  </div>

  <div class="products-luxury-grid">
    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% else %}
      <div style="grid-column: 1 / -1; text-align: center; padding: 64px 0;">
        <span style="font-size: 3.5rem; display: block; margin-bottom: 12px;">🧸</span>
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 8px;">No toys found in this category yet!</h3>
        <p style="color: var(--color-dark-muted); font-size: 1rem; margin-bottom: 24px;">Check back soon or explore our most-loved essentials.</p>
        <a href="/collections/all" class="btn-motion-primary" style="display: inline-flex;">
          <span>Explore All Toys 🚀</span>
        </a>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}