{% assign collection = collections[section.settings.collection] | default: collections.all %}

<section class="catalog-section">
  <div class="container">
    <div class="reels-header reveal-on-scroll">
      <div>
        <span class="section-tag">{{ section.settings.badge | default: 'Kid-Approved Essentials' }}</span>
        <h2 class="section-heading-lg">{{ section.settings.title | default: 'Most-Loved Play Essentials' }}</h2>
        <p class="section-subtext">Designed for endless open-ended play. Crafted from non-toxic, child-safe, planet-friendly materials.</p>
      </div>

      <div>
        <a href="/collections/all" class="btn-motion-glass" style="color: var(--color-dark); border-color: var(--color-orange); font-size: 0.95rem; padding: 12px 24px;">
          View All Toys (8) &rarr;
        </a>
      </div>
    </div>

    <div class="products-luxury-grid">
      {% for product in collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% else %}
        <!-- 1: Rainbow Stacker -->
        <div class="luxury-product-card tilt-card reveal-on-scroll">
          <div class="card-media-wrapper">
            <img src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=700&q=80" alt="Montessori Wooden Rainbow">
            <div class="card-pill-tags">
              <span class="pill-tag pill-eco">FSC Wood</span>
              <span class="pill-tag pill-bestseller">Parent Favorite</span>
            </div>
            <div class="quick-add-overlay">
              <button class="btn-quick-add btn-add-card" data-variant-id="default">
                + Quick Add to Toybox
              </button>
            </div>
          </div>
          <div class="card-details">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <span class="card-category">Montessori Wood</span>
              <span style="color: #F59E0B; font-size: 0.85rem; font-weight: 800;">★★★★★ 5.0</span>
            </div>
            <h3 class="card-title"><a href="/collections/all">Montessori Natural Wooden Rainbow Stacker</a></h3>
            <div class="card-pricing-row">
              <div>
                <span class="price-current">$38.00</span>
                <span class="price-compare">$48.00</span>
              </div>
              <div class="stock-dot-indicator">In Stock</div>
            </div>
          </div>
        </div>

        <!-- 2: Solar Robotics -->
        <div class="luxury-product-card tilt-card reveal-on-scroll">
          <div class="card-media-wrapper">
            <img src="https://images.unsplash.com/photo-1485827404703-89b55fcc595e?auto=format&fit=crop&w=700&q=80" alt="Solar Robotics Kit">
            <div class="card-pill-tags">
              <span class="pill-tag pill-stem">STEM Certified</span>
            </div>
            <div class="quick-add-overlay">
              <button class="btn-quick-add btn-add-card" data-variant-id="default">
                + Quick Add to Toybox
              </button>
            </div>
          </div>
          <div class="card-details">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <span class="card-category">STEM &amp; Robotics</span>
              <span style="color: #F59E0B; font-size: 0.85rem; font-weight: 800;">★★★★★ 4.9</span>
            </div>
            <h3 class="card-title"><a href="/collections/all">Solar &amp; Hydro Robotic Science Explorers Kit</a></h3>
            <div class="card-pricing-row">
              <div>
                <span class="price-current">$49.50</span>
                <span class="price-compare">$62.00</span>
              </div>
              <div class="stock-dot-indicator">In Stock</div>
            </div>
          </div>
        </div>

