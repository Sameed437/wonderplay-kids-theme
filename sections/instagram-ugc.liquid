<section class="social-ugc-section">
  <div class="container">
    <div class="reels-header reveal-on-scroll" style="text-align: center; display: block; max-width: 680px; margin: 0 auto 36px;">
      <span class="section-tag">Playroom In The Wild</span>
      <h2 class="section-heading-lg">Moments of Focus &amp; Wild Laughter 📸</h2>
      <p class="section-subtext" style="margin: 8px auto 0;">
        Follow along <a href="https://instagram.com" target="_blank" rel="noopener" style="color: var(--color-orange); font-weight: 800; text-decoration: underline;">@wonderplaykids</a> and tag your space with <strong>#PlayWonder</strong>
      </p>
    </div>

    <div class="ugc-grid reveal-on-scroll">
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=600&q=80" alt="Toddler playing with sensory stackers" loading="lazy">
        <div class="ugc-overlay">
          <span>📷 @themontessorinest</span>
        </div>
      </div>
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=600&q=80" alt="Nordic playroom decor" loading="lazy">
        <div class="ugc-overlay">
          <span>📷 @scandikidsplay</span>
        </div>
      </div>
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=600&q=80" alt="Montessori stacking wooden tower" loading="lazy">
        <div class="ugc-overlay">
          <span>📷 @wildwood_learning</span>
        </div>
      </div>
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=600&q=80" alt="Kid with balance bike in park" loading="lazy">
        <div class="ugc-overlay">
          <span>📷 @raisingadventurers</span>
        </div>
      </div>
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1513542789411-b6a5d4f31634?auto=format&fit=crop&w=600&q=80" alt="Creative pottery sculpting clay" loading="lazy">
        <div class="ugc-overlay">
          <span>📷 @artful_playroom</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social UGC Grid",
  "settings": [],
  "presets": [
    {
      "name": "Social UGC Grid"
    }
  ]
}
{% endschema %}