<section class="social-ugc-section">
  <div class="container">
    <span class="section-tag">Playroom In The Wild</span>
    <h2 class="section-heading-lg">Moments of quiet focus & wild laughter.</h2>
    <p class="section-subtext" style="margin: 8px auto 0;">Follow along <a href="#" style="color: var(--color-terracotta); font-weight: 700;">@wonderplaykids</a> and tag your space with #PlayWonder</p>

    <div class="ugc-grid">
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=600&q=80" alt="Toddler playing with sensory stackers">
        <div class="ugc-overlay">📷</div>
      </div>
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=600&q=80" alt="Nordic playroom decor">
        <div class="ugc-overlay">📷</div>
      </div>
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=600&q=80" alt="Montessori stacking wooden tower">
        <div class="ugc-overlay">📷</div>
      </div>
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=600&q=80" alt="Kid with balance bike in park">
        <div class="ugc-overlay">📷</div>
      </div>
      <div class="ugc-tile">
        <img src="https://images.unsplash.com/photo-1513542789411-b6a5d4f31634?auto=format&fit=crop&w=600&q=80" alt="Creative pottery sculpting clay">
        <div class="ugc-overlay">📷</div>
      </div>
    </div>
  </div>
</section>

