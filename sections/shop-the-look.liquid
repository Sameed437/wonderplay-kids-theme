<section class="hotspot-section">
  <div class="container">
    <div class="reels-header reveal-on-scroll" style="text-align: center; display: block; max-width: 680px; margin: 0 auto 40px;">
      <span class="section-tag">Interactive Nursery</span>
      <h2 class="section-heading-lg">Step Inside The Modern Playroom! 🏠</h2>
      <p class="section-subtext" style="margin: 8px auto 0;">Click on any pulsing pin (+) to discover the Montessori-approved toys inside this room.</p>
    </div>

    <!-- Hotspot Interactive Canvas -->
    <div class="hotspot-canvas reveal-on-scroll">
      <img 
        src="https://images.unsplash.com/photo-1513542789411-b6a5d4f31634?auto=format&fit=crop&w=1400&q=85" 
        alt="Nordic styled playroom with curated toys" 
        class="hotspot-main-image"
      >

      <!-- Pin 1: Montessori Rainbow -->
      <div class="hotspot-pin-wrapper" style="top: 42%; left: 32%;">
        <button class="hotspot-pin" data-target="popover-1" aria-label="View Rainbow Stacker">
          <span class="pin-radar"></span>
          <span class="pin-dot">+</span>
        </button>

        <div id="popover-1" class="hotspot-popover">
          <img src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=200&q=80" alt="Rainbow Stacker">
          <div>
            <div class="popover-title">Montessori Wooden Rainbow</div>
            <div class="popover-price">$38.00</div>
            <button class="popover-add-btn btn-add-card" data-variant-id="default">Add to Toybox</button>
          </div>
        </div>
      </div>

      <!-- Pin 2: Calming Bear -->
      <div class="hotspot-pin-wrapper" style="top: 60%; left: 68%;">
        <button class="hotspot-pin" data-target="popover-2" aria-label="View Calming Bear">
          <span class="pin-radar"></span>
          <span class="pin-dot">+</span>
        </button>

        <div id="popover-2" class="hotspot-popover">
          <img src="https://images.unsplash.com/photo-1559454403-b8fb88521f11?auto=format&fit=crop&w=200&q=80" alt="Weighted Bear">
          <div>
            <div class="popover-title">Barnaby Weighted Bear</div>
            <div class="popover-price">$34.00</div>
            <button class="popover-add-btn btn-add-card" data-variant-id="default">Add to Toybox</button>
          </div>
        </div>
      </div>

      <!-- Pin 3: Pottery Studio -->
      <div class="hotspot-pin-wrapper" style="top: 28%; left: 78%;">
        <button class="hotspot-pin" data-target="popover-3" aria-label="View Pottery Wheel">
          <span class="pin-radar"></span>
          <span class="pin-dot">+</span>
        </button>

        <div id="popover-3" class="hotspot-popover">
          <img src="https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=200&q=80" alt="Pottery Studio">
          <div>
            <div class="popover-title">Deluxe Pottery Wheel</div>
            <div class="popover-price">$44.00</div>
            <button class="popover-add-btn btn-add-card" data-variant-id="default">Add to Toybox</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop The Playroom Hotspots",
  "settings": [],
  "presets": [
    {
      "name": "Shop The Playroom Hotspots"
    }
  ]
}
{% endschema %}
