<div class="password-screen-container">
  <div class="password-card-box">
    <!-- Official Wonderplay Logo -->
    <img 
      src="{{ 'logo.png' | asset_url }}" 
      alt="Wonderplay — Where Fun Begins!" 
      class="password-logo-img"
    >

    <div class="password-badge">
      <span>✨ Grand Opening Coming Soon!</span>
    </div>

    <h1 class="password-heading">Our Magical Toybox <br/>is Opening Soon! 🎈</h1>
    <p class="password-subtext">
      We are preparing the finest Montessori wooden sets, science kits, and sensory toys. Enter your store password below to preview the full store:
    </p>

    <!-- Password Form (Shopify Native) -->
    <div class="password-form-wrapper">
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <div class="password-input-row">
          <input 
            type="password" 
            name="password" 
            id="Password" 
            class="password-field" 
            placeholder="Enter store password..."
            autofocus
          >
          <button type="submit" class="password-submit-btn">
            Enter Store &rarr;
          </button>
        </div>
      {% endform %}
    </div>

    <!-- Quick Help for Store Owner -->
    <div style="margin-top: 24px; padding-top: 18px; border-top: 1px dashed var(--color-border); font-size: 0.82rem; color: #6B7280;">
      <span>💡 Store Owner Tip: You can disable this password screen in <strong>Shopify Admin &rarr; Online Store &rarr; Preferences</strong></span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password Page",
  "settings": []
}
{% endschema %}
