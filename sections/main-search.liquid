<div class="container" style="padding: 48px 24px;">
  <h1 style="text-align: center; margin-bottom: 32px; font-size: 2.2rem;">Search Results for "{{ search.terms | escape }}"</h1>
  <div class="products-grid">
    {% for item in search.results %}
      {% if item.object_type == 'product' %}
        {% render 'product-card', product: item %}
      {% endif %}
    {% else %}
      <p style="text-align: center; grid-column: 1 / -1; color: #64748B; padding: 48px 0;">No toys found matching your search. Try another word!</p>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
