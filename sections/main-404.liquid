<div class="container" style="text-align: center; padding: clamp(64px, 10vw, 120px) 24px;">
  <span style="font-size: 5rem; display: block; margin-bottom: 16px;">🧸</span>
  <span class="section-tag">404 Error</span>
  <h1 style="font-size: clamp(2.4rem, 4vw, 3.4rem); margin: 12px 0 16px;">Oops! Page Not Found</h1>
  <p style="color: var(--color-dark-muted); font-size: 1.15rem; max-width: 500px; margin: 0 auto 32px; line-height: 1.6; font-weight: 600;">
    The toy or page you are looking for must have rolled under the couch! Let's get you back to playtime.
  </p>
  <a href="{{ routes.root_url }}" class="btn-motion-primary" style="display: inline-flex;">
    <span>Back to Playroom 🚀</span>
  </a>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}